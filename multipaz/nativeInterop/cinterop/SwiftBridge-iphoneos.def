package = org.multipaz
language = Objective-C

headers = SwiftBridge/SwiftBridge-Swift.h
headerFilter = SwiftBridge/*

staticLibraries = libSwiftBridge.a
libraryPaths = SwiftBridge/build/Release-iphoneos

linkerOpts = -L/usr/lib/swift
linkerOpts.ios_x64 = -platform_version ios 14.0 14.0
linkerOpts.ios_arm64 = -platform_version ios 14.0 14.0
